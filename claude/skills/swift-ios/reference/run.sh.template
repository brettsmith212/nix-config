#!/usr/bin/env bash
# Build, install, and launch <AppName> on the iOS Simulator.
# Boots the simulator if needed and pipes the build log through
# xcode-build-server so sourcekit-lsp stays happy.
#
# Substitute:
#   PROJECT — path to the .xcodeproj (e.g. "<AppName>.xcodeproj"
#             or "<SubDir>/<AppName>.xcodeproj" for sample-code layouts)
#   SCHEME  — the scheme name (usually <AppName>)

set -euo pipefail

PROJECT="<AppName>.xcodeproj"
SCHEME="<AppName>"
DEVICE="${DEVICE:-iPhone 17 Pro}"
DESTINATION="platform=iOS Simulator,name=${DEVICE}"

cd "$(dirname "$0")"

# Boot simulator if not already booted, and bring Simulator.app to the front.
if ! xcrun simctl list devices booted | grep -q "${DEVICE} "; then
  echo "▶ Booting ${DEVICE}…"
  xcrun simctl boot "${DEVICE}"
fi
open -a Simulator

# Build (incremental) and feed the log to xcode-build-server for LSP.
echo "▶ Building ${SCHEME}…"
xcodebuild -project "${PROJECT}" -scheme "${SCHEME}" \
  -destination "${DESTINATION}" build \
  | xcode-build-server parse -av \
  | xcpretty 2>/dev/null || true

# Resolve the freshly-built .app path and bundle id from build settings.
# Reading PRODUCT_BUNDLE_IDENTIFIER here (instead of hardcoding) handles
# sample-code projects whose bundle id is derived from ${DEVELOPMENT_TEAM}.
read -r APP_PATH BUNDLE_ID < <(
  xcodebuild -project "${PROJECT}" -scheme "${SCHEME}" \
    -destination "${DESTINATION}" -showBuildSettings 2>/dev/null \
  | awk -F' = ' '
      / BUILT_PRODUCTS_DIR /{d=$2}
      / FULL_PRODUCT_NAME /{n=$2}
      / PRODUCT_BUNDLE_IDENTIFIER /{b=$2}
      END{print d"/"n, b}'
)

if [[ ! -d "${APP_PATH}" ]]; then
  echo "✗ Could not locate built app at: ${APP_PATH}" >&2
  exit 1
fi

echo "▶ Installing ${APP_PATH}"
xcrun simctl install booted "${APP_PATH}"

echo "▶ Terminating previous instance (if any)…"
xcrun simctl terminate booted "${BUNDLE_ID}" >/dev/null 2>&1 || true

echo "▶ Launching ${BUNDLE_ID}"
xcrun simctl launch booted "${BUNDLE_ID}"
